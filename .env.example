# إعدادات الاتصال بسيرفر أودو CCD
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية:  cp .env.example .env
# ملف .env مستثنى من Git ولن يُرفع أبداً.

# ── أودو (XML-RPC عبر HTTPS) ──
ODOO_URL=https://erp.ccd.sa
ODOO_DB=ccd_erp
ODOO_USER=admin
# يُفضّل بشدة استخدام API key بدلاً من كلمة المرور:
# Settings → Users → حسابك → Account Security → New API Key
ODOO_API_KEY=

# ── SSH (للمهام التي تحتاج الجهاز نفسه — تُشغَّل من جهازك المحلي، لا من هذه البيئة) ──
SSH_HOST=85.190.254.163
SSH_USER=root
# لا تضع كلمة مرور SSH هنا — استخدم مفتاح SSH:  ssh-copy-id root@85.190.254.163
